/* ===========================================================================
 *  ResProbe - resource script
 *
 *  Compiled with windres (see Makefile):
 *      windres -I res res/resprobe.rc -o build/res.o
 *
 *  Content is deliberately pure ASCII: windres string handling is code-page
 *  sensitive on MinGW, and English literals avoid the whole question.
 *  All resource names below are bare numbers so no windows.h include is needed.
 *
 *      ID 1  RT_ICON        -> not used directly, the ICO carries its own set
 *      1     ICON (3)       -> resprobe.ico        default
 *      2     ICON (3)       -> resprobe-green.ico  monitor online
 *      3     ICON (3)       -> resprobe-blue.ico   Windows turned the display off
 *      4     ICON (3)       -> resprobe-red.ico    no virtual-display fallback
 *      5     ICON (3)       -> resprobe-yellow.ico fallback active (virtual carries desktop)
 *      1     RT_MANIFEST(24)-> resprobe.manifest (elevation + compatibility)
 *
 *  The five ICON ids are selected at runtime by src/tray.cpp (TrayIconState).
 *  Regenerate all five with `make icon`; do not hand-edit the .ico files.
 * ===========================================================================
 */

/* ---- tray icons: default / online / display off / no fallback / fallback -- */
1 ICON "resprobe.ico"
2 ICON "resprobe-green.ico"
3 ICON "resprobe-blue.ico"
4 ICON "resprobe-red.ico"
5 ICON "resprobe-yellow.ico"

/* ---- manifest: requireAdministrator, DPI awareness, supported OS ---------- */
1 24 "resprobe.manifest"

/* ---- version information --------------------------------------------------
 * Shown by explorer, Get-Item .\resprobe.exe | Format-List VersionInfo,
 * and by pnputil/schtasks diagnostics. Keep in sync with RESPROBE_VERSION
 * in src/common.h.
 */
1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ResProbe"
            VALUE "FileDescription",  "ResProbe display resolution and remote desktop diagnostics"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "resprobe"
            VALUE "LegalCopyright",   "Copyright (c) 2026 ResProbe contributors. Licensed under the MIT License."
            VALUE "OriginalFilename", "resprobe.exe"
            VALUE "ProductName",      "ResProbe"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
